{
  "name": "deploygenie",
  "displayName": "DeployGenie AI",
  "description": "Autonomous AI Release Engineering Platform",
  "version": "0.0.1",
  "publisher": "deploygenie-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/111satwika/ReleaseForge-AI.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deploygenie",
          "title": "DeployGenie",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "deploygenie": [
        {
          "type": "webview",
          "id": "deploygenie.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "deploygenie.ping",
        "title": "DeployGenie: Ping Backend"
      },
      {
        "command": "deploygenie.restartBackend",
        "title": "DeployGenie: Restart Backend"
      }
    ],
    "configuration": {
      "title": "DeployGenie",
      "properties": {
        "deploygenie.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8420",
          "description": "URL of the local DeployGenie Core backend."
        },
        "deploygenie.backendDir": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Path to the DeployGenie backend folder (the one containing app/main.py). Leave empty to be prompted once. User-level only, so an untrusted workspace can't redirect it."
        },
        "deploygenie.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Python interpreter to run the backend with. Leave empty to auto-detect <backendDir>/.venv. User-level only, so an untrusted workspace can't redirect it."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "release": "npm run compile && node scripts/release.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
