{
  "name": "releaseforge-ai",
  "displayName": "ReleaseForge AI",
  "description": "Autonomous AI Release Engineering Platform",
  "version": "0.0.1",
  "publisher": "releaseforge-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/111satwika/ReleaseForge-AI.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "releaseforge",
          "title": "ReleaseForge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "releaseforge": [
        {
          "type": "webview",
          "id": "releaseforge.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "releaseforge.ping",
        "title": "ReleaseForge: Ping Backend"
      },
      {
        "command": "releaseforge.restartBackend",
        "title": "ReleaseForge: Restart Backend"
      },
      {
        "command": "releaseforge.showDashboard",
        "title": "ReleaseForge: Show Dashboard",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "releaseforge.showDashboard",
          "when": "view == releaseforge.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ReleaseForge",
      "properties": {
        "releaseforge.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8420",
          "description": "URL of the local ReleaseForge AI Core backend."
        },
        "releaseforge.backendDir": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Path to the ReleaseForge backend folder (the one containing app/main.py). Leave empty to be prompted once. User-level only, so an untrusted workspace can't redirect it."
        },
        "releaseforge.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Python interpreter to run the backend with. Leave empty to auto-detect <backendDir>/.venv. User-level only, so an untrusted workspace can't redirect it."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "release": "npm run compile && node scripts/release.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
